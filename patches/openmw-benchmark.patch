     float BindingsManager::getActionValue(int id) const
     {
+#ifdef __PROSPERO__
+        if (MWPS5Benchmark::inputActive())
+        {
+            const MWPS5Benchmark::InputState input = MWPS5Benchmark::inputState();
+            switch (id)
+            {
+                case A_MoveForward:
+                    return MWPS5Benchmark::actionIsActive(MWPS5Benchmark::Action::Forward) ? 1.f : 0.f;
+                case A_MoveBackward:
+                    return MWPS5Benchmark::actionIsActive(MWPS5Benchmark::Action::Backward) ? 1.f : 0.f;
+                case A_MoveLeft:
+                    return MWPS5Benchmark::actionIsActive(MWPS5Benchmark::Action::Left) ? 1.f : 0.f;
+                case A_MoveRight:
+                    return MWPS5Benchmark::actionIsActive(MWPS5Benchmark::Action::Right) ? 1.f : 0.f;
+                case A_MoveForwardBackward:
+                    return 0.5f - input.forward * 0.5f;
+                case A_MoveLeftRight:
+                    return 0.5f + input.strafe * 0.5f;
+                case A_LookUpDown:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::LookY);
+                case A_LookLeftRight:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::LookX);
+                case A_Jump:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::Jump);
+                case A_Activate:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::Activate);
+                case A_Use:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::Attack);
+                case A_Run:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::Run);
+                case A_Sneak:
+                    return MWPS5Benchmark::actionValue(MWPS5Benchmark::Action::Sneak);
+            }
+        }
+#endif
         return mInputBinder->getChannel(id)->getValue();
     }
 
